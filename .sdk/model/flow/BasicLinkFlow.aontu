# BasicLinkFlow

main: kit: flow: BasicLinkFlow:
{
  entity: "link",
  kind: "basic",
  name: "BasicLinkFlow",
  step: [
    {
      i: {
        ref: "link_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "link_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "link_ref01",
        srcdatavar: "link_ref01_data",
        suffix: "_up0",
        textfield: "createdAt"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-link_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "link_ref01",
        srcdatavar: "link_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "link01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-link_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "link_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "link01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "link_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicLinkFlow"
}