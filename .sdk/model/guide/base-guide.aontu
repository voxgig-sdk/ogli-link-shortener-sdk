# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 2
  metrics: count: path: 3
  metrics: count: method: 6

  entity: link: {
    path: "/links": {
      op: create: method: *POST
      op: list: method: *GET
      op: list: transform: res: *("`body.links`")|top
    }
    path: "/links/{linkId}": {
      rename: param: "linkId": *"id"
      op: load: method: *GET
      op: remove: method: *DELETE
      op: update: method: *PUT
    }
  }

  entity: link_stat: {
    path: "/links/{linkId}/stats": {
      rename: param: "linkId": *"id"
      op: list: method: *GET
    }
  }

}